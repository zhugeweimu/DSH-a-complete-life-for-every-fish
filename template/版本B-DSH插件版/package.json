{
  "name": "dsh-memory-core",
  "version": "0.1.0",
  "description": "把本地 memory-core（SQLite + 检索 + 日志/事件）接进 DSH：只注册工具，不自动注入上下文。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "deepseek-harness"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  }
}
